{
  "name": "dsh-github-trending",
  "version": "0.6.0",
  "description": "Daily GitHub trending briefing: an overall leaderboard plus per-domain hotspots, summarized by the model.",
  "license": "MIT",
  "author": "prophetcrab",
  "homepage": "https://github.com/prophetcrab/dsh-github-trending#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prophetcrab/dsh-github-trending.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "github",
    "trending",
    "briefing"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
